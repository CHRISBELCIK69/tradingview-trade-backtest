//@version=6
// Trade Replay Backtest — generated by pine_export.py from your trades.
//
// Open the underlying's chart (AMD, SPY, SPX for SPXW, ...) on an intraday
// timeframe. The script enters at each of YOUR real entry times for trades
// on that symbol, then exits by the rules in the settings, so you can test
// exit rules against the entries you actually took.
//
// Pine can't see option prices, so the option is modeled with
// Black-Scholes on the chart's price. Implied volatility is solved on the
// entry bar so the modeled price equals your real fill, then held there;
// time decay comes from the shrinking time to expiry. Stops, targets and
// P&L in the results table are on that modeled option price.
//
// The Strategy Tester trades the stock, sized at the option's delta x 100
// shares per contract, so its numbers only roughly track the option. The
// table on the chart is the option P&L to read.
strategy("Trade Replay Backtest", overlay = true, process_orders_on_close = true,
     initial_capital = 10000, max_labels_count = 500)

// ---------------------------------------------------------------- inputs

stopPct    = input.float(30.0, "Stop loss (option %, 0 = off)", minval = 0, group = "Exits")
targetPct  = input.float(50.0, "Take profit (option %, 0 = off)", minval = 0, group = "Exits")
trailPct   = input.float(0.0, "Trailing stop from best (option %, 0 = off)", minval = 0, group = "Exits")
vwapExit   = input.bool(false, "Exit when price crosses back through VWAP", group = "Exits")
emaExit    = input.bool(false, "Exit when price crosses back through EMA", group = "Exits")
emaLen     = input.int(20, "EMA length", minval = 1, group = "Exits")
maxBars    = input.int(0, "Time stop (bars, 0 = off)", minval = 0, group = "Exits")
eodExit    = input.bool(false, "Flat by time of day", group = "Exits")
eodTime    = input.int(1555, "Flat by (ET, HHMM)", minval = 930, maxval = 1615, group = "Exits")

rate       = input.float(4.0, "Risk-free rate %", group = "Model") / 100
commission = input.float(0.65, "Commission per contract, each side ($)", minval = 0, group = "Model")
showLabels = input.bool(true, "Label each exit", group = "Display")
showReal   = input.bool(true, "Mark my real exits", group = "Display")

// ---------------------------------------------------------------- trades

var array<string> tkA   = array.new<string>()
var array<int>    entA  = array.new<int>()
var array<int>    exA   = array.new<int>()
var array<float>  ePxA  = array.new<float>()
var array<float>  xPxA  = array.new<float>()
var array<bool>   callA = array.new<bool>()
var array<float>  kA    = array.new<float>()
var array<int>    expA  = array.new<int>()
var array<float>  qtyA  = array.new<float>()

addTrade(string tk, int entMs, int exMs, float ePx, float xPx, bool isCall, float strike, int expMs, float qty) =>
    tkA.push(tk)
    entA.push(entMs)
    exA.push(exMs)
    ePxA.push(ePx)
    xPxA.push(xPx)
    callA.push(isCall)
    kA.push(strike)
    expA.push(expMs)
    qtyA.push(qty)

if barstate.isfirst
    // ticker, entry time, real exit time, entry price, real exit price, call?, strike, expiry (16:00 ET), contracts
//@@TRADES@@

// ---------------------------------------------------------------- model

ncdf(float x) =>
    t = 1.0 / (1.0 + 0.2316419 * math.abs(x))
    d = 0.3989422804014327 * math.exp(-x * x / 2.0)
    p = d * t * (0.319381530 + t * (-0.356563782 + t * (1.781477937 + t * (-1.821255978 + t * 1.330274429))))
    x >= 0 ? 1.0 - p : p

MIN_T = 60.0 / (365.0 * 24 * 3600)   // one minute, so prices stay finite at the bell

bsPrice(float s, float k, float t, float iv, bool isCall) =>
    tt = math.max(t, MIN_T)
    sd = iv * math.sqrt(tt)
    d1 = (math.log(s / k) + (rate + iv * iv / 2) * tt) / sd
    d2 = d1 - sd
    disc = math.exp(-rate * tt)
    isCall ? s * ncdf(d1) - k * disc * ncdf(d2) : k * disc * ncdf(-d2) - s * ncdf(-d1)

bsDelta(float s, float k, float t, float iv, bool isCall) =>
    tt = math.max(t, MIN_T)
    d1 = (math.log(s / k) + (rate + iv * iv / 2) * tt) / (iv * math.sqrt(tt))
    isCall ? ncdf(d1) : ncdf(d1) - 1

impliedVol(float px, float s, float k, float t, bool isCall) =>
    lo = 0.01
    hi = 10.0
    for i = 0 to 59
        mid = (lo + hi) / 2
        if bsPrice(s, k, t, mid, isCall) < px
            lo := mid
        else
            hi := mid
    (lo + hi) / 2

yearsLeft(int expMs, int atMs) =>
    (expMs - atMs) / (365.0 * 24 * 3600 * 1000)

signedPct(float v) =>
    (v > 0 ? "+" : "") + str.tostring(v, "0") + "%"

// ---------------------------------------------------------------- signals

vw = ta.vwap(hlc3)
ema = ta.ema(close, emaLen)
plot(vw, "VWAP", color.new(color.purple, 0), 2)
plot(ema, "EMA", color.new(color.orange, 0), 1)
upVwap = ta.crossover(close, vw)
dnVwap = ta.crossunder(close, vw)
upEma = ta.crossover(close, ema)
dnEma = ta.crossunder(close, ema)
etMin = hour(time_close, "America/New_York") * 60 + minute(time_close, "America/New_York")

// ---------------------------------------------------------------- replay

var int   nextI = 0
var bool  inTrade = false
var int   tI = -1
var float iv = na
var float peak = na
var int   entryBar = na
var string tradeId = ""

// results: rules vs your real exits, over the same trades
var int   nRules = 0
var int   winRules = 0
var float sumPctRules = 0.0
var float usdRules = 0.0
var int   nReal = 0
var int   winReal = 0
var float sumPctReal = 0.0
var float usdReal = 0.0
var int   skipped = 0
var int   beforeHistory = 0
var int   badFill = 0

if barstate.isfirst
    for i = 0 to tkA.size() - 1
        if tkA.get(i) == syminfo.ticker and entA.get(i) < time
            beforeHistory += 1

// Exit first, so a trade that ends on this bar frees the slot for one entering on it.
if inTrade and bar_index > entryBar
    isCall = callA.get(tI)
    k = kA.get(tI)
    ePx = ePxA.get(tI)
    t = yearsLeft(expA.get(tI), time_close)
    px = bsPrice(close, k, t, iv, isCall)
    pxHi = bsPrice(isCall ? high : low, k, t, iv, isCall)
    pxLo = bsPrice(isCall ? low : high, k, t, iv, isCall)
    string reason = ""
    float exitPx = na
    // Both stop and target inside one bar: assume the stop hit first (the conservative read).
    if stopPct > 0 and pxLo <= ePx * (1 - stopPct / 100)
        reason := "stop"
        exitPx := ePx * (1 - stopPct / 100)
    else if targetPct > 0 and pxHi >= ePx * (1 + targetPct / 100)
        reason := "target"
        exitPx := ePx * (1 + targetPct / 100)
    else if trailPct > 0 and peak > ePx and pxLo <= peak * (1 - trailPct / 100)
        reason := "trail"
        exitPx := peak * (1 - trailPct / 100)
    else if vwapExit and (isCall ? dnVwap : upVwap)
        reason := "vwap"
    else if emaExit and (isCall ? dnEma : upEma)
        reason := "ema"
    else if maxBars > 0 and bar_index - entryBar >= maxBars
        reason := "time"
    else if eodExit and etMin >= math.floor(eodTime / 100.0) * 60 + eodTime % 100
        reason := "eod"
    else if time_close >= expA.get(tI)
        reason := "expiry"
    peak := math.max(peak, pxHi)

    if reason != ""
        exitPx := na(exitPx) ? px : exitPx
        qty = qtyA.get(tI)
        pct = (exitPx - ePx) / ePx * 100
        nRules += 1
        winRules += pct > 0 ? 1 : 0
        sumPctRules += pct
        usdRules += (exitPx - ePx) * 100 * qty - 2 * commission * qty
        xPx = xPxA.get(tI)
        string realTxt = ""
        if not na(xPx)
            realPct = (xPx - ePx) / ePx * 100
            nReal += 1
            winReal += realPct > 0 ? 1 : 0
            sumPctReal += realPct
            usdReal += (xPx - ePx) * 100 * qty - 2 * commission * qty
            realTxt := "\nreal " + signedPct(realPct)
        strategy.close(tradeId, comment = reason)
        if showLabels
            label.new(bar_index, isCall ? high : low, reason + " " + signedPct(pct) + realTxt,
                 style = isCall ? label.style_label_down : label.style_label_up,
                 color = pct > 0 ? color.new(color.green, 20) : color.new(color.red, 20), textcolor = color.white, size = size.small)
        inTrade := false

// Mark the real exit of the open trade on the bar it happened.
if showReal and tI >= 0 and not na(exA.get(tI)) and exA.get(tI) >= time and exA.get(tI) < time_close
    label.new(bar_index, callA.get(tI) ? low : high, "real exit " + str.tostring(xPxA.get(tI), "#.##"),
         style = callA.get(tI) ? label.style_label_up : label.style_label_down, color = color.new(color.purple, 20),
         textcolor = color.white, size = size.tiny)

// Entries: every trade whose entry time falls since the previous bar closed.
prevClose = nz(time_close[1], time)
while nextI < tkA.size() and entA.get(nextI) < time_close
    i = nextI
    nextI += 1
    if tkA.get(i) != syminfo.ticker or entA.get(i) < prevClose
        continue
    if inTrade
        skipped += 1
        continue
    isCall = callA.get(i)
    k = kA.get(i)
    t = yearsLeft(expA.get(i), time_close)
    ePx = ePxA.get(i)
    // A fill no IV can price (outside 1%-1000%) still trades, but is counted as off-model.
    if ePx <= bsPrice(close, k, t, 0.01, isCall) or ePx >= bsPrice(close, k, t, 10.0, isCall)
        badFill += 1
    iv := impliedVol(ePx, close, k, t, isCall)
    tI := i
    inTrade := true
    entryBar := bar_index
    peak := ePx
    tradeId := "T" + str.tostring(i)
    shares = math.max(1, math.round(math.abs(bsDelta(close, k, t, iv, isCall)) * 100 * qtyA.get(i)))
    strategy.entry(tradeId, isCall ? strategy.long : strategy.short, qty = shares,
         comment = (isCall ? "C " : "P ") + str.tostring(k) + " @" + str.tostring(ePx, "#.##"))

modelPx = inTrade ? bsPrice(close, kA.get(tI), yearsLeft(expA.get(tI), time_close), iv, callA.get(tI)) : na
plot(modelPx, "Modeled option price", display = display.data_window)

// ---------------------------------------------------------------- results

var table tbl = table.new(position.top_right, 3, 8, bgcolor = color.new(color.black, 15), border_width = 1)

pctTxt(float v) =>
    (v > 0 ? "+" : "") + str.tostring(v, "0.0") + "%"

row(int r, string name, string a, string b) =>
    table.cell(tbl, 0, r, name, text_color = color.silver, text_halign = text.align_left, text_size = size.small)
    table.cell(tbl, 1, r, a, text_color = color.white, text_size = size.small)
    table.cell(tbl, 2, r, b, text_color = color.white, text_size = size.small)

if barstate.islast
    row(0, syminfo.ticker + " option P&L", "Rules", "Real exits")
    row(1, "Trades", str.tostring(nRules), str.tostring(nReal))
    row(2, "Win rate", nRules > 0 ? str.tostring(100.0 * winRules / nRules, "0") + "%" : "—", nReal > 0 ? str.tostring(100.0 * winReal / nReal, "0") + "%" : "—")
    row(3, "Avg per trade", nRules > 0 ? pctTxt(sumPctRules / nRules) : "—", nReal > 0 ? pctTxt(sumPctReal / nReal) : "—")
    row(4, "Total $", str.tostring(usdRules, "#,##0"), str.tostring(usdReal, "#,##0"))
    row(5, "Still open", inTrade ? "1" : "0", "")
    row(6, "Skipped (overlap)", str.tostring(skipped), "")
    row(7, "Before chart history", str.tostring(beforeHistory), badFill > 0 ? str.tostring(badFill) + " off-model fill(s)" : "")
